{{!
    @template local_courseaiassistant/conversation_download

    Renders a conversation as a standalone HTML download.

    Context variables required for this template:
    * title
    * coursename
    * messages
    * messages.author
    * messages.message

    Example context (json):
    {
        "title": "Course conversation",
        "coursename": "Example course",
        "messages": [
            {
                "author": "AI Course Assistant",
                "message": "Hello"
            }
        ]
    }
}}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{title}}</title>
</head>
<body>
    <h1>{{title}}</h1>
    <p>{{coursename}}</p>
    {{#messages}}
        <h2>{{author}}</h2>
        <p>{{{message}}}</p>
    {{/messages}}
</body>
</html>
